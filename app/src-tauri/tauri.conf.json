{
  "productName": "gemini-gui",
  "version": "0.1.0",
  "identifier": "com.gemini.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gemini Agent CLI",
        "label": "main",
        "width": 400,
        "height": 700,
        "decorations": true,
        "alwaysOnTop": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "focus": true,
        "center": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.gemini.gui",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}