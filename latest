async function chatWithUser(userMessage) {
    // 시스템은 무조건 'currentActiveCacheId'만 참조하여 포킹(Forking)함
    const model = genAI.getGenerativeModelFromCachedContent({ 
        name: currentActiveCacheId 
    });

    // 전체 데이터를 보내지 않고, 사용자 질문만 전송함 (비용 0에 수렴)
    const result = await model.generateContent(userMessage);
    return result.response.text();
}
