diff yaml 만드는 로직 이렇게 필요해

요청하신 Git 방식의 라인 단위 YAML Diff를 생성하고 관리하는 Node.js 코드입니다.

이 로직은 두 개의 객체(수정 전, 수정 후)를 비교하여, 말씀하신 형태의 +, - 가 포함된 텍스트 컨텍스트를 정확하게 뽑아냅니다. (표준 패키지인 js-yaml과 diff를 사용합니다.)

JavaScript
// npm install js-yaml diff
const yaml = require('js-yaml');
const Diff = require('diff');

/**
 * 1. YAML 만드는 로직 (Base YAML)
 * JSON 객체를 순수 YAML 포맷으로 변환합니다.
 */
function createBaseYaml(data) {
    return yaml.dump(data, {
        indent: 2,
        noArrayIndent: false
    });
}

/**
 * 2. Diff YAML 만드는 로직 (Git-style Diff)
 * 수정 전 데이터와 수정 후 데이터를 비교하여 +,- 표기가 된 텍스트를 반환합니다.
 */
function createYamlDiff(oldData, newData, targetOrderId) {
    // 각각의 데이터를 YAML 문자열로 변환
    const oldYaml = createBaseYaml(oldData);
    const newYaml = createBaseYaml(newData);

    // 라인 단위로 Diff 계산 (Git 방식)
    const diffs = Diff.diffLines(oldYaml, newYaml);

    // 최상단에 target_order_id 고정 출력
    let diffString = `target_order_id: "${targetOrderId}"\n`;

    // 변경점 순회하며 포맷팅
    diffs.forEach((part) => {
        // 빈 줄 제거
        const lines = part.value.split('\n').filter(line => line.length > 0);
        
        lines.forEach(line => {
            if (part.added) {
                diffString += `+ ${line}\n`;     // 추가/수정된 내용
            } else if (part.removed) {
                diffString += `- ${line}\n`;     // 삭제/수정전 내용
            } else {
                diffString += `  ${line}\n`;     // 변경 없는 컨텍스트 (맥락 유지용)
            }
        });
    });

    return diffString;
}

// =====================================================================
// [실행 예시 시나리오]
// =====================================================================

