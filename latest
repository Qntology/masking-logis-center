// 전역 변수로 현재의 활성 프롬프트 ID(캐시 ID)를 관리합니다.
let currentActiveCacheId = "projects/.../cachedContents/Cache-ID-V1"; 

async function applyAfterUpdateAndTransmitContext(latestYamlString) {
    console.log("👉 데이터가 변경되었습니다. 컨텍스트를 최신화(Swap) 합니다.");

    // 1. 기존 오염된/과거의 캐시 ID 삭제 (메모리 비우기)
    try {
        await cacheManager.delete(currentActiveCacheId);
        console.log(`🧹 기존 캐시(${currentActiveCacheId}) 삭제 완료`);
    } catch (e) {
        console.log("기존 캐시가 이미 만료되었거나 없습니다.");
    }

    // 2. 최신화된 전체 YAML을 올려 '새로운 캐시 ID' 발급 (컨텍스트 전송 준비)
    const newCache = await cacheManager.create({
        model: 'models/gemini-1.5-flash-001',
        contents: [{
            role: 'user',
            parts: [{ text: `최신 커머스 장부:\n${latestYamlString}` }]
        }],
        ttlSeconds: 3600, // 1시간 유지
    });

    // 3. 전역 프롬프트 ID를 새 ID로 갈아 끼움 (Swap)
    currentActiveCacheId = newCache.name;
    console.log(`✨ 새로운 캐시 발급 완료! 이제부터 모든 대화는 [${currentActiveCacheId}] 를 바라봅니다.`);
}

// ---------------------------------------------------------
