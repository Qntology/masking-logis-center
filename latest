    const currentHistory = [
        { role: 'user', parts: [{ text: `장부 데이터: ${yamlData}` }] },
        { role: 'model', parts: [{ text: "네, 장부 확인했습니다." }] },
        { role: 'user', parts: [{ text: "1005번 고객이 어제 받은 옷이 찢어졌다고 화를 내셔." }] },
        { role: 'model', parts: [{ text: "1005번 주문 내역 확인했습니다. 전액 환불 도와드릴까요?" }] },
        { role: 'user', parts: [{ text: "응, 전액 환불하고 배송비도 우리가 부담하는 걸로 처리해줘." }] }
    ];

    // 이 대화 배열 전체를 캐시로 생성 (새로운 Cache ID 발급)
    const csSnapshotCache = await cacheManager.create({
        model: 'models/gemini-1.5-flash-001',
        contents: currentHistory,
        ttlSeconds: 300, // 5분만 유지하는 임시 분기점
    });

    const snapshotId = csSnapshotCache.name;
    const forkedModel = genAI.getGenerativeModelFromCachedContent({ name: snapshotId });

    console.log(`✅ 대화 스냅샷 완료 (ID: ${snapshotId}). 2개의 브랜치로 포킹합니다.`);

    // [포크 1: 백엔드 시스템용 브랜치] - JSON 추출 후 자동 종료
    const apiBranch = forkedModel.generateContent(`
        위 대화 맥락을 바탕으로 결제사 환불 API에 보낼 JSON 페이로드만 작성해.
        배송비 포함 전액 환불 조건이야.
    `);

    // [포크 2: 고객 응대용 브랜치] - 메일 작성 후 자동 종료
    const emailBranch = forkedModel.generateContent(`
        고객에게 보낼 정중한 사과 및 환불 처리 완료 이메일 초안을 작성해줘.
    `);

    const [apiResult, emailResult] = await Promise.all([apiBranch, emailBranch]);

    console.log("🚀 [Branch 1 API Data]:\n", apiResult.response.text());
    console.log("📧 [Branch 2 Email Text]:\n", emailResult.response.text());

    // 모든 작업이 끝났으므로 임시로 구운 스냅샷 캐시를 삭제(Pruning)하여 깔끔하게 정리합니다.
    await cacheManager.delete(snapshotId);
    console.log("🧹 임시 스냅샷 캐시 삭제 완료. 오염 원천 차단.");
}
