요청하신 대로 줄 번호가 병합되어 출력되도록 수정한 로직을 보여드릴게요.

JavaScript
const yaml = require('js-yaml');
const Diff = require('diff');

function createBaseYaml(data) {
    return yaml.dump(data, {
        indent: 2,
        noArrayIndent: false
    });
}

/**
 * 2. Diff YAML 만드는 로직 (줄 번호 포함)
 * startLine 파라미터로 원본 파일 내 해당 주문의 실제 시작 줄 번호를 넘겨주면 더 정확해집니다.
 */
function createYamlDiffWithLines(oldData, newData, targetOrderId, startLine = 1) {
    const oldYaml = createBaseYaml(oldData);
    const newYaml = createBaseYaml(newData);

    const diffs = Diff.diffLines(oldYaml, newYaml);

    let diffString = `target_order_id: "${targetOrderId}"\n`;

    // 줄 번호 추적용 카운터
    let oldLineNum = startLine; 
    let newLineNum = startLine;

    diffs.forEach((part) => {
        // 빈 줄 제거 (split 특성상 마지막에 남는 빈 문자열 처리)
        const lines = part.value.split('\n').filter(line => line.length > 0);
        
        lines.forEach(line => {
            if (part.added) {
                // 추가된 내용은 새로운 파일의 줄 번호 기준
                diffString += `${newLineNum}+ ${line}\n`;     
                newLineNum++;
            } else if (part.removed) {
                // 삭제된 내용은 원본 파일의 줄 번호 기준
                diffString += `${oldLineNum}- ${line}\n`;     
                oldLineNum++;
            } else {
                // 변경 없는 내용은 보통 원본 줄 번호를 표기
                diffString += `${oldLineNum}  ${line}\n`;     
                oldLineNum++;
                newLineNum++;
            }
        });
    });

    return diffString;
}

// =====================================================================
// [실행 결과 예시]
// =====================================================================

const oldOrder = {
  shipping_info: { company: "우체국택배", tracking_no: "0000-0000" }
};

const newOrder = {
  shipping_info: { company: "대한통운", tracking_no: "1234-5678" }
};

// 원본 YAML 파일에서 이 주문건이 200번째 줄부터 시작한다고 가정
const aiContextDiff = createYamlDiffWithLines(oldOrder, newOrder, "1001", 200);
console.log(aiContextDiff);
