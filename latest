async function branchForDashboard(cacheId) {
    console.log("👉 [서브 브랜치 생성] 대시보드 요약 데이터 추출 중...");

    // 1. 메인 캐시 ID 참조 (토큰 비용 0원)
    const model = genAI.getGenerativeModelFromCachedContent({ name: cacheId });

    // 2. 일회성 질의 (채팅 히스토리 배열을 쓰지 않는 generateContent)
    const prompt = `
        현재 장부에서 아래 항목을 JSON으로 정확히 추출해. 
        - 총 주문 건수
        - 배송 중 건수
        - 오늘 발생한 취소 건수
        응답 포맷: {"total": 0, "shipping": 0, "canceled": 0}
    `;

    const result = await model.generateContent(prompt);
    const dashboardData = result.response.text();

    console.log("✅ 대시보드 데이터:", dashboardData);
    // 함수가 종료되면 이 브랜치의 메모리는 자동 소멸 (Pruning 완료)
